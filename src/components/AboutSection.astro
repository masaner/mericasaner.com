---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  lang: Lang;
}

const { profile, lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section">
  <div class="container">
    <div class="about-card card">
      <div class="about-header">
        <span class="eyebrow">{t('section.about.eyebrow')}</span>
        <h2>{t('section.about.title')}</h2>
      </div>

      <div class="about-content">
        <div class="about-text">
          {profile.about[lang].map((p) => (
            <p class="about-paragraph">{p}</p>
          ))}
        </div>

        <div class="about-sidebar">
          <!-- Languages Spoken -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">{lang === 'tr' ? 'Diller' : 'Languages'}</h3>
            <ul class="sidebar-list">
              {profile.languages.map((l) => (
                <li class="sidebar-list-item">
                  <span class="item-name">{l.name[lang]}</span>
                  <span class="badge">{l.level[lang]}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Location & Base -->
          <div class="sidebar-box">
            <h3 class="sidebar-title">{lang === 'tr' ? 'Çalışma Modeli' : 'Location & Work'}</h3>
            <p class="sidebar-text">
              {profile.location[lang]} ·{' '}
              {lang === 'tr' ? 'Tamamen uzaktan (Remote)' : 'Available Remote worldwide'}
            </p>
          </div>
        </div>
      </div>

      <!-- Side Projects & Mobile Applications (Hobby) -->
      {profile.sideProjects && (
        <div class="side-projects-section">
          <div class="side-projects-header">
            <div class="side-projects-title-row">
              <span class="side-projects-badge">
                <svg
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
                {t('about.sideProjects.badge')}
              </span>
              <h3 class="side-projects-title">{profile.sideProjects.title[lang]}</h3>
            </div>
            <p class="side-projects-sub">{profile.sideProjects.description[lang]}</p>
          </div>

          <div class="side-projects-grid">
            {profile.sideProjects.items.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="side-project-card"
                aria-label={`${item.name} — ${item.badge[lang]}`}
              >
                <div class="side-project-top">
                  <div class="side-project-name-group">
                    <span class="side-project-name">{item.name}</span>
                    <span class="side-project-tag">{item.badge[lang]}</span>
                  </div>
                  <span class="external-link-icon" aria-hidden="true">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </span>
                </div>
                <p class="side-project-desc">{item.description[lang]}</p>
                <div class="side-project-bottom">
                  <ul class="side-project-tags">
                    {item.tags.map((tag) => (
                      <li class="mini-tag">{tag}</li>
                    ))}
                  </ul>
                  <span class="side-project-visit">
                    <span>{t('about.sideProjects.visit')}</span>
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about-card {
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--slds-g-radius-4);
  }

  .about-header {
    margin-bottom: 1.5rem;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 800px) {
    .about-content {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .about-paragraph {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-box {
    padding: 1.25rem;
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--slds-g-radius-3);
  }

  .sidebar-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-color);
    margin-bottom: 0.75rem;
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9375rem;
  }

  .item-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .sidebar-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Side Projects & Mobile Applications Showcase */
  .side-projects-section {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border-color);
  }

  .side-projects-header {
    margin-bottom: 1.5rem;
  }

  .side-projects-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .side-projects-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--slds-g-radius-pill);
    background: rgba(1, 118, 211, 0.08);
    color: var(--brand-color);
    border: 1px solid rgba(1, 118, 211, 0.2);
  }

  .side-projects-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .side-projects-sub {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 65ch;
  }

  .side-projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .side-projects-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .side-project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem;
    border-radius: var(--slds-g-radius-3);
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-color);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .side-project-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-color);
    background: var(--bg-surface);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .side-project-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .side-project-name-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .side-project-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .side-project-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-color);
  }

  .external-link-icon {
    color: var(--text-muted);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }

  .side-project-card:hover .external-link-icon {
    color: var(--brand-color);
    transform: translate(2px, -2px);
  }

  .side-project-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .side-project-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .side-project-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .mini-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    border-radius: var(--slds-g-radius-1);
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--border-color);
  }

  .side-project-visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand-color);
    margin-top: auto;
  }

  .side-project-visit svg {
    transition: transform 0.15s ease;
  }

  .side-project-card:hover .side-project-visit svg {
    transform: translateX(3px);
  }
</style>
