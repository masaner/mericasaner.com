---
import { getCollection } from 'astro:content';
import { useTranslations, formatFullDate, calculateReadingTime } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = [...allPosts].sort((a, b) => b.data.date.localeCompare(a.data.date));
const blogBasePath = lang === 'tr' ? '/tr/blog' : '/blog';
---

<section class="section blog-index-section">
  <div class="container blog-index-container">
    <header class="section-head blog-index-head">
      <span class="eyebrow">{t('blog.eyebrow')}</span>
      <h1>{t('blog.title')}</h1>
      <p class="section-sub">{t('blog.sub')}</p>
    </header>

    {posts.length === 0 ? (
      <div class="card blog-empty-card">
        <p>{t('blog.empty')}</p>
      </div>
    ) : (
      <div class="blog-list">
        {posts.map((post) => {
          const postUrl = `${blogBasePath}/${post.data.slug}`;
          const minutes = calculateReadingTime(post.body);
          const readingTimeLabel = t('blog.readingTime').replace('{min}', String(minutes));
          const formattedDate = formatFullDate(post.data.date, lang);

          return (
            <article class="blog-card card">
              <div class="blog-card-meta">
                <div class="blog-card-meta-left">
                  <time datetime={post.data.date} class="blog-date">
                    {formattedDate}
                  </time>
                  <span class="meta-dot" aria-hidden="true">
                    ·
                  </span>
                  <span class="blog-reading-time">{readingTimeLabel}</span>
                </div>

                {post.data.repoUrl && (
                  <a
                    href={post.data.repoUrl}
                    class="blog-repo-pill"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${post.data.title} — GitHub`}
                  >
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    <span>GitHub</span>
                  </a>
                )}
              </div>

              <h2 class="blog-card-title">
                <a href={postUrl} class="blog-card-link">
                  {post.data.title}
                </a>
              </h2>

              <p class="blog-card-summary">{post.data.summary}</p>

              <div class="blog-card-footer">
                <ul class="tags" aria-label="Topics">
                  {post.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>

                <a href={postUrl} class="read-more-link">
                  <span>{t('blog.readArticle')}</span>
                  <svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .blog-index-section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .blog-index-container {
    max-width: 880px;
  }

  .blog-index-head h1 {
    font-size: clamp(2rem, 1.35rem + 2.4vw, 2.85rem);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-empty-card {
    padding: 2.5rem;
    text-align: center;
    color: var(--text-muted);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.35rem, 3.2vw, 2rem);
    border-radius: var(--slds-g-radius-4);
  }

  .blog-card:hover {
    transform: translateY(-2px);
    border-color: var(--brand-color);
  }

  .blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .blog-card-meta-left {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .blog-date {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .blog-repo-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--slds-g-radius-pill);
    background: var(--bg-surface-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .blog-repo-pill:hover {
    color: var(--brand-color);
    border-color: var(--brand-color);
  }

  .blog-card-title {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .blog-card-link {
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .blog-card-link:hover {
    color: var(--brand-color);
  }

  .blog-card-summary {
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .blog-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-color);
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-color);
    white-space: nowrap;
  }

  .read-more-link svg {
    transition: transform 0.18s ease;
  }

  .read-more-link:hover svg {
    transform: translateX(3px);
  }
</style>
