---
import { useTranslations, calculateYears } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  lang: Lang;
}

const { profile, lang } = Astro.props;
const t = useTranslations(lang);

const years = calculateYears(profile.careerStart);
const ledeText = profile.lede[lang].replace('{years}', String(years));

// Format headline with italic/color highlight on *asterisks*
const rawHeadline = profile.headline[lang];
const formattedHeadline = rawHeadline.replace(
  /\*(.*?)\*/g,
  '<span class="hero-highlight">$1</span>',
);
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-main">
      <!-- Status Badge -->
      {profile.openToWork && (
        <div class="hero-status">
          <span class="status-indicator" aria-hidden="true">
            <span class="status-ping"></span>
            <span class="status-dot"></span>
          </span>
          <span class="status-text">{t('hero.badge.open')}</span>
        </div>
      )}

      <!-- Introduction & Headline -->
      <div class="hero-titles">
        <p class="hero-greeting">
          {lang === 'tr' ? 'Merhaba, ben' : "Hi, I'm"}{' '}
          <span class="hero-name">{profile.shortName}</span>.
        </p>
        <h1 class="hero-headline" set:html={formattedHeadline} />
        <p class="hero-role">{profile.title[lang]}</p>
      </div>

      <!-- Lede -->
      <p class="hero-lede">{ledeText}</p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          {t('hero.cta.contact')}
        </a>
        <a href="#projects" class="btn btn-secondary">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          {t('hero.cta.work')}
        </a>
        <a
          href={profile.links.linkedin}
          class="btn btn-subtle icon-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          title="LinkedIn"
        >
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>
        {profile.links.github && (
          <a
            href={profile.links.github}
            class="btn btn-subtle icon-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            title="GitHub"
          >
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Architecture & Systems Highlights Card -->
    <div class="hero-record-card card">
      <div class="record-header">
        <span class="record-badge">
          <svg
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          FULL STACK ARCHITECTURE · HIGHLIGHTS
        </span>
      </div>

      <div class="record-grid">
        {profile.recordFields.map((field) => (
          <div class="record-item">
            <span class="record-label">{field.label[lang]}</span>
            <span class="record-value">{field.value[lang]}</span>
          </div>
        ))}
      </div>

      <!-- Career Progression Path -->
      <div class="career-path-container">
        <span class="career-path-title">{t('hero.careerPath.label')}</span>
        <div class="slds-path" role="list">
          {profile.careerPath.map((step, idx) => {
            const isCurrent = idx === profile.careerPath.length - 1;
            return (
              <div
                class:list={[
                  'slds-path-step',
                  { 'step-current': isCurrent, 'step-complete': !isCurrent },
                ]}
                role="listitem"
              >
                <span class="step-label">{step[lang]}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    background: radial-gradient(circle at 10% 20%, rgba(1, 118, 211, 0.04) 0%, transparent 40%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--slds-g-radius-pill);
    background: var(--badge-bg);
    border: 1px solid var(--border-color);
    margin-bottom: 1.25rem;
  }

  .status-indicator {
    position: relative;
    display: inline-flex;
    width: 8px;
    height: 8px;
  }

  .status-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: #10b981;
    opacity: 0.75;
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .status-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--badge-text);
  }

  .hero-greeting {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .hero-name {
    color: var(--text-primary);
    font-weight: 700;
  }

  .hero-headline {
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  :global(.hero-highlight) {
    background: linear-gradient(135deg, var(--brand-color) 0%, #04844b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-role {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    font-weight: 600;
    color: var(--brand-color);
    margin-bottom: 1.25rem;
  }

  .hero-lede {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: var(--slds-g-radius-pill);
    border: 1px solid var(--border-color);
  }

  /* Salesforce Record Card */
  .hero-record-card {
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color-strong);
    border-radius: var(--slds-g-radius-4);
  }

  .record-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1.25rem;
  }

  .record-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--brand-color);
  }

  .record-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 480px) {
    .record-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .record-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .record-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .record-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Career Progression Path (SLDS Path Chevron component) */
  .career-path-container {
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .career-path-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .slds-path {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (min-width: 500px) {
    .slds-path {
      flex-direction: row;
      align-items: stretch;
      gap: 0.25rem;
    }
  }

  .slds-path-step {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    border-radius: var(--slds-g-radius-1);
    background: var(--bg-surface-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all 0.15s ease;
  }

  .step-complete {
    background: rgba(4, 132, 75, 0.08);
    color: #04844b;
    border-color: rgba(4, 132, 75, 0.2);
  }

  .step-current {
    background: var(--brand-color);
    color: var(--brand-contrast);
    border-color: var(--brand-color);
    box-shadow: 0 1px 3px rgba(1, 118, 211, 0.3);
  }
</style>
