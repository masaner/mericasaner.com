---
import { getEntry, getCollection } from 'astro:content';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import ExperienceTimeline from './ExperienceTimeline.astro';
import ProjectsList from './ProjectsList.astro';
import CertificationsGrid from './CertificationsGrid.astro';
import SkillsGrid from './SkillsGrid.astro';
import ContactSection from './ContactSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) {
  throw new Error('Profile entry "main" not found in src/content/profile.yaml');
}
const profile = profileEntry.data;

const experiences = await getCollection('experience');
const projects = await getCollection('projects');
const certifications = await getCollection('certifications');
const skills = await getCollection('skills');
---

<section class="resume-hero">
  <div class="container">
    <div class="resume-header-box card">
      <div class="resume-header-top">
        <div class="resume-title-col">
          <span class="eyebrow">{t('resume.eyebrow')}</span>
          <h1>{t('resume.title')}</h1>
          <p class="section-sub">{t('resume.sub')}</p>
        </div>

        <div class="resume-external-actions">
          <a
            href={profile.links.linkedin}
            class="btn btn-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
            </svg>
            <span>LinkedIn</span>
          </a>

          {profile.links.github && (
            <a
              href={profile.links.github}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span>GitHub</span>
            </a>
          )}

          <a href="#contact" class="btn btn-primary">
            <span>{t('hero.cta.contact')}</span>
          </a>
        </div>
      </div>

      <nav class="resume-jump-nav" aria-label={t('resume.jumpLabel')}>
        <span class="jump-label">{t('resume.jumpLabel')}:</span>
        <ul class="jump-pills">
          <li>
            <a href="#experience" class="jump-pill">
              {t('nav.experience')}
            </a>
          </li>
          <li>
            <a href="#projects" class="jump-pill">
              {t('nav.projects')}
            </a>
          </li>
          <li>
            <a href="#certifications" class="jump-pill">
              {t('nav.certifications')}
            </a>
          </li>
          <li>
            <a href="#skills" class="jump-pill">
              {t('nav.skills')}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</section>

<ExperienceTimeline experiences={experiences} lang={lang} />
<ProjectsList projects={projects} lang={lang} />
<CertificationsGrid certifications={certifications} lang={lang} />
<SkillsGrid skills={skills} lang={lang} />
<ContactSection profile={profile} lang={lang} />

<style>
  .resume-hero {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 0.5rem;
    background: radial-gradient(circle at 12% 15%, rgba(1, 118, 211, 0.04) 0%, transparent 45%);
  }

  .resume-header-box {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--slds-g-radius-4);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .resume-header-top {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .resume-header-top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .resume-title-col h1 {
    font-size: clamp(2rem, 1.35rem + 2.4vw, 2.85rem);
  }

  .resume-external-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .resume-jump-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .jump-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .jump-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .jump-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--slds-g-radius-pill);
    background: var(--bg-surface-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .jump-pill:hover {
    color: var(--brand-color);
    border-color: var(--brand-color);
    background: var(--bg-surface);
  }
</style>
