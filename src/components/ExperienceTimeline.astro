---
import { useTranslations, formatYearMonth } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  experiences: CollectionEntry<'experience'>[];
  lang: Lang;
}

const { experiences, lang } = Astro.props;
const t = useTranslations(lang);

// Sort experiences descending by start date
const sorted = [...experiences].sort((a, b) => b.data.start.localeCompare(a.data.start));
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t('section.experience.eyebrow')}</span>
      <h2>{t('section.experience.title')}</h2>
      <p class="section-sub">{t('section.experience.sub')}</p>
    </div>

    <div class="timeline" role="list">
      {sorted.map((item) => {
        const d = item.data;
        const startFormatted = formatYearMonth(d.start, lang, t('common.present'));
        const endFormatted = formatYearMonth(d.end, lang, t('common.present'));
        const periodStr = `${startFormatted} — ${endFormatted}`;
        const isCurrent = !d.end;

        const employmentLabel =
          d.employment === 'contract'
            ? t('common.contract')
            : d.employment === 'internship'
              ? t('common.internship')
              : t('common.fulltime');

        return (
          <article class:list={['timeline-item card', { 'is-current': isCurrent }]} role="listitem">
            <div class="timeline-meta">
              <span class="timeline-period">{periodStr}</span>
              <span class="timeline-location">{d.location[lang]}</span>
              <span class="badge timeline-badge">{employmentLabel}</span>
            </div>

            <div class="timeline-content">
              <div class="timeline-title-row">
                <h3 class="role-title">{d.role[lang]}</h3>
                <div class="company-row">
                  <span class="company-at">@</span>
                  {d.url ? (
                    <a
                      href={d.url}
                      class="company-name company-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {d.company}
                      <svg
                        aria-hidden="true"
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </a>
                  ) : (
                    <span class="company-name">{d.company}</span>
                  )}
                </div>
              </div>

              {d.context && <p class="company-context">{d.context[lang]}</p>}

              <ul class="highlights-list">
                {d.highlights.map((h) => (
                  <li class="highlight-item">{h[lang]}</li>
                ))}
              </ul>

              {d.tags && d.tags.length > 0 && (
                <ul class="tags experience-tags">
                  {d.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--slds-g-radius-3);
  }

  @media (min-width: 768px) {
    .timeline-item {
      grid-template-columns: 220px 1fr;
      gap: 2rem;
    }
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }

  .timeline-period {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .timeline-location {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .timeline-badge {
    margin-top: 0.25rem;
  }

  .timeline-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .role-title {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .company-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .company-at {
    color: var(--text-muted);
    font-weight: 500;
  }

  .company-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--brand-color);
  }

  .company-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .company-context {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
  }

  .highlights-list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .highlight-item {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .experience-tags {
    margin-top: 0.75rem;
  }
</style>
