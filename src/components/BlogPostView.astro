  }

  .article-footer {
    margin-top: 1.75rem;
  }
</style>

<script>
  const timers = new WeakMap<Element, ReturnType<typeof setTimeout>>();
  let lastMessage = '';
  let initialized = false;

  function getProseLabels() {
    const prose = document.querySelector<HTMLElement>('.blog-prose');
    return {
      copied: prose?.dataset.copiedText || 'Copied',
      failed: prose?.dataset.failedText || 'Copy failed',
      copyLabel: prose?.dataset.copyLabel || '',
      tableLabel: prose?.dataset.tableLabel || '',
    };
  }

  function report(button: Element, ok: boolean) {
    const tip = button.nextElementSibling;
    if (!(tip instanceof HTMLElement)) return;

    const existingTimer = timers.get(button);
    if (existingTimer) clearTimeout(existingTimer);

    button.removeAttribute('data-copied');
    button.removeAttribute('data-failed');

    const labels = getProseLabels();
    let message = ok ? labels.copied : labels.failed;
    if (message === lastMessage) message += '\u00A0';
    lastMessage = message;

    tip.textContent = '';
    void (button as HTMLElement).offsetWidth;
    button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
    requestAnimationFrame(() => {
      tip.textContent = message;
    });

    timers.set(
      button,
      setTimeout(() => {
        button.removeAttribute('data-copied');
        button.removeAttribute('data-failed');
        tip.textContent = '';
      }, 2000),
    );
  }

  async function copy(button: Element, target: HTMLElement) {
    const text =
      target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement
        ? target.value
        : target.innerText.trim();
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      report(button, true);
    } catch {
      report(button, false);
    }
  }

  function localizeAttributes() {
    if (document.documentElement.lang !== 'tr') return;
    const labels = getProseLabels();
    if (labels.tableLabel) {
      document.querySelectorAll('.blog-prose .table-wrapper').forEach((el) => {
        el.setAttribute('aria-label', labels.tableLabel);
      });
    }
    if (labels.copyLabel) {
      document.querySelectorAll('.blog-prose .copy-button').forEach((btn) => {
        const lang = btn.closest('.code-frame')?.querySelector('.code-lang')?.textContent?.trim();
        btn.setAttribute('aria-label', lang ? `${labels.copyLabel} (${lang})` : labels.copyLabel);
      });
    }
  }

  function setupBlogCopy() {
    localizeAttributes();
    if (initialized) return;
    initialized = true;

    if ('CommandEvent' in window) {
      document.addEventListener(
        'command',
        (event: Event) => {
          const cmdEvent = event as Event & {
            command?: string;
            source?: Element | null;
            target: EventTarget | null;
          };
          if (
            cmdEvent.command?.startsWith('--copy') &&
            cmdEvent.source &&
            cmdEvent.target instanceof HTMLElement
          ) {
            copy(cmdEvent.source, cmdEvent.target);
          }
        },
        true,
      );
    } else {
      document.addEventListener('click', (event) => {
        const targetEl = event.target;
        if (!(targetEl instanceof Element)) return;
        const button = targetEl.closest('button[command^="--copy"]');
        if (!button) return;
        const targetId = button.getAttribute('commandfor');
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (target) copy(button, target);
      });
    }
  }

  setupBlogCopy();
  document.addEventListener('astro:page-load', setupBlogCopy);
</script>
