---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'tr' ? '/tr' : '/';
---

<header class="site-header">
  <div class="cosmos-accent-bar" aria-hidden="true"></div>
  <div class="container header-inner">
    <a href={homePath} class="logo" aria-label="Meriç Alper Aşaner - Home">
      <span class="logo-mark">MA</span>
      <span class="logo-dot" aria-hidden="true">
        .
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li>
          <a href="#experience" class="nav-link">
            {t('nav.experience')}
          </a>
        </li>
        <li>
          <a href="#projects" class="nav-link">
            {t('nav.projects')}
          </a>
        </li>
        <li>
          <a href="#certifications" class="nav-link">
            {t('nav.certifications')}
          </a>
        </li>
        <li>
          <a href="#skills" class="nav-link">
            {t('nav.skills')}
          </a>
        </li>
        <li>
          <a href="#about" class="nav-link">
            {t('nav.about')}
          </a>
        </li>
        <li>
          <a href="#contact" class="nav-link">
            {t('nav.contact')}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Controls & CTAs -->
    <div class="header-controls">
      <LangSwitch currentLang={lang} />
      <ThemeToggle lang={lang} />
      <a href="#contact" class="btn btn-primary header-cta">
        {t('hero.cta.contact')}
      </a>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-trigger"
        class="mobile-menu-btn"
        type="button"
        aria-label={t('common.menuOpen')}
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="icon-menu"
          aria-hidden="true"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          class="icon-close"
          aria-hidden="true"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="mobile-drawer-content">
      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          <li>
            <a href="#experience" class="mobile-nav-link">
              {t('nav.experience')}
            </a>
          </li>
          <li>
            <a href="#projects" class="mobile-nav-link">
              {t('nav.projects')}
            </a>
          </li>
          <li>
            <a href="#certifications" class="mobile-nav-link">
              {t('nav.certifications')}
            </a>
          </li>
          <li>
            <a href="#skills" class="mobile-nav-link">
              {t('nav.skills')}
            </a>
          </li>
          <li>
            <a href="#about" class="mobile-nav-link">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href="#contact" class="mobile-nav-link">
              {t('nav.contact')}
            </a>
          </li>
        </ul>
        <div class="mobile-drawer-footer">
          <a href="#contact" class="btn btn-primary" style="width: 100%">
            {t('hero.cta.contact')}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1rem;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .logo-mark {
    background: linear-gradient(135deg, var(--brand-color), #04844b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-dot {
    color: var(--brand-color);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--brand-color);
  }

  /* Header controls */
  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    display: none;
  }

  /* Mobile Button */
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--slds-g-radius-2);
    color: var(--text-primary);
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-color);
  }

  .mobile-menu-btn .icon-close {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .mobile-menu-btn[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .mobile-nav-link {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-nav-link:hover {
    color: var(--brand-color);
  }

  @media (min-width: 860px) {
    .desktop-nav {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }

    .mobile-menu-btn {
      display: none;
    }

    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script>
  function setupMobileDrawer() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const links = drawer?.querySelectorAll('.mobile-nav-link');
    if (!trigger || !drawer) return;

    function toggle(open?: boolean) {
      const isCurrentlyOpen = trigger!.getAttribute('aria-expanded') === 'true';
      const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

      trigger!.setAttribute('aria-expanded', String(shouldOpen));
      drawer!.setAttribute('aria-hidden', String(!shouldOpen));

      if (shouldOpen) {
        drawer!.classList.add('open');
        document.body.style.overflow = 'hidden';
      } else {
        drawer!.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    trigger.addEventListener('click', () => toggle());
    backdrop?.addEventListener('click', () => toggle(false));
    links?.forEach((l) => l.addEventListener('click', () => toggle(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        toggle(false);
      }
    });
  }

  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
