---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);

// Sort projects by order
const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t('section.projects.eyebrow')}</span>
      <h2>{t('section.projects.title')}</h2>
      <p class="section-sub">{t('section.projects.sub')}</p>
    </div>

    <div class="projects-grid">
      {sorted.map((proj) => {
        const d = proj.data;
        return (
          <article class="project-card card">
            <div class="project-header">
              <div class="project-meta">
                <span class="project-org">{d.org}</span>
                <span class="project-period">{d.period}</span>
              </div>
              <h3 class="project-title">{d.title[lang]}</h3>
              {d.featured && (
                <div class="project-featured-callout">
                  <svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                    <polyline points="16 7 22 7 22 13"></polyline>
                  </svg>
                  <span>{d.featured[lang]}</span>
                </div>
              )}
            </div>

            <div class="case-study-details">
              <div class="case-step">
                <h4 class="step-title challenge-title">
                  <span class="step-dot" aria-hidden="true"></span>
                  {t('common.challenge')}
                </h4>
                <p class="step-desc">{d.challenge[lang]}</p>
              </div>

              <div class="case-step">
                <h4 class="step-title contribution-title">
                  <span class="step-dot" aria-hidden="true"></span>
                  {t('common.contribution')}
                </h4>
                <p class="step-desc">{d.contribution[lang]}</p>
              </div>

              <div class="case-step">
                <h4 class="step-title outcome-title">
                  <span class="step-dot" aria-hidden="true"></span>
                  {t('common.outcome')}
                </h4>
                <p class="step-desc outcome-text">{d.outcome[lang]}</p>
              </div>
            </div>

            <div class="project-footer">
              <ul class="tags">
                {d.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--slds-g-radius-4);
  }

  .project-header {
    margin-bottom: 1.25rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .project-org {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-color);
  }

  .project-period {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .project-title {
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .project-featured-callout {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--border-color);
    border-radius: var(--slds-g-radius-2);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .case-study-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    margin-bottom: 1.25rem;
    padding-top: 0.5rem;
  }

  .case-step {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .step-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .step-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-color-strong);
  }

  .challenge-title .step-dot {
    background: #eab308;
  }

  .contribution-title .step-dot {
    background: var(--brand-color);
  }

  .outcome-title .step-dot {
    background: #10b981;
  }

  .step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .outcome-text {
    font-weight: 500;
    color: var(--text-primary);
  }

  .project-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }
</style>
